# Copy to .env and point these at your own copies. Every one has a working
# in-repo default, so a fresh clone runs without setting any of them; they
# exist so that corpora and artifacts can live outside the repo, on whatever
# filesystem a given machine keeps them on.

# Shared corpus root: MusicCaps metadata/captions and moisesdb.zip live under
# here. Read by derive_stem_priors.py, filter_musiccaps_manifest.py, and the
# `captions` path in configs/ground_truth/rejection.yaml.
RIME_SHARED_ROOT=data/shared

# MusicCaps audio + metadata root, used by build_analysis_manifest.py. Usually
# "$RIME_SHARED_ROOT/musiccaps".
RIME_MUSICCAPS_ROOT=data/shared/musiccaps

# Where generated artifacts are written: rendered audio, plan JSONL, figures
# and filtered manifests. Read by render_permissible_plans.py,
# plot_distributions.py and filter_musiccaps_manifest.py.
RIME_ARTIFACTS_ROOT=derived

# Hugging Face cache for tag_instruments.py. Leave unset to use the standard
# HF resolution order (HF_HOME, HUGGINGFACE_HUB_CACHE, ~/.cache/huggingface).
# RIME_HF_CACHE_DIR=
